# =============================================================================
# ms-nutrition-planner (BC2) - variables de entorno
# Copiar a .env:   cp .env.example .env
# =============================================================================

# -- MySQL --------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=FOODV2
MYSQL_USER=grobles
MYSQL_PASSWORD=12345678

# Puerto del HOST para conectarse a la BD (3307 para no chocar con un MySQL local)
MYSQL_HOST_PORT=3307

# -- Aplicacion ---------------------------------------------------------------
# Tag semver fijo (nunca latest). Al publicar en Docker Hub, usar
# <usuario-dockerhub>/ms-nutrition-planner:1.0.0
APP_IMAGE=ms-nutrition-planner:1.0.0
APP_HOST_PORT=7000

# -- Integracion con la plataforma (platform/) --------------------------------
# true solo si Kafka de la plataforma esta levantado (stack del grupo)
KAFKA_ENABLED=true
